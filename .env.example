# Copie para .env (no seu computador) ou cadastre em Vercel → Settings → Environment Variables.
# Nunca coloque valores reais neste arquivo: ele vai para o GitHub.

# Asaas. Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
# Com a URL do sandbox aparece o botão "Simular pagamento"; em produção ele some sozinho.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# No .env, entre aspas simples por causa do "$" do começo. Na Vercel, sem aspas.
ASAAS_API_KEY='$aact_...'
# Mesmo valor do "Token de autenticação" do webhook no painel do Asaas (gere um aleatório longo)
ASAAS_WEBHOOK_TOKEN=

# Mensalidade em reais
PLANO_VALOR=97

# Para onde a LP manda os eventos, assinados com AUTOMACAO_SEGREDO (o mesmo valor de LP_SEGREDO no CheckZap)
# LEAD_WEBHOOK_URL: lead salvo antes de pagar · AUTOMACAO_URL: pagamento aprovado, estorno, cancelamento
LEAD_WEBHOOK_URL=
AUTOMACAO_URL=
AUTOMACAO_SEGREDO=

# Endereço público da LP (https). Com o domínio cadastrado no Asaas, o cliente volta para /obrigado depois de pagar.
SITE_URL=http://localhost:8080
